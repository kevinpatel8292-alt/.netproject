@model Doctor
@{ ViewData["Title"] = "Delete Doctor"; }
<div class="card shadow-sm border-0 p-4"><h2>Delete Doctor</h2><p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
<form asp-action="Delete" method="post"><input type="hidden" asp-for="DoctorId"/><button class="btn btn-danger">Yes, Delete</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form></div>
