@model IEnumerable<Doctor>
@{ ViewData["Title"] = "Doctors"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Doctors</h2><a class="btn btn-primary" asp-action="Create">+ Add Doctor</a></div>
<div class="table-responsive bg-white rounded-3 shadow-sm"><table class="table table-hover mb-0">
<thead><tr><th>Name</th><th>Specialization</th><th>Phone</th><th>Actions</th></tr></thead><tbody>
@foreach (var d in Model) { <tr><td>@d.Name</td><td>@d.Specialization</td><td>@d.Phone</td><td>
<a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@d.DoctorId">Edit</a>
<a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@d.DoctorId">Delete</a></td></tr> }
</tbody></table></div>
