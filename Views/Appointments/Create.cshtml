@model Appointment
@{ ViewData["Title"] = "New Appointment"; }
<h2>New Appointment</h2>
<form asp-action="Create" method="post" class="card p-4 shadow-sm border-0">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="PatientId" class="form-label">Patient</label><select asp-for="PatientId" class="form-select"><option value="">Select patient</option>@foreach (var p in ViewBag.Patients) { <option value="@p.PatientId">@p.Name</option> }</select></div>
<div class="mb-3"><label asp-for="DoctorId" class="form-label">Doctor</label><select asp-for="DoctorId" class="form-select"><option value="">Select doctor</option>@foreach (var d in ViewBag.Doctors) { <option value="@d.DoctorId">@d.Name - @d.Specialization</option> }</select></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="AppointmentDate" class="form-label"></label><input asp-for="AppointmentDate" type="date" class="form-control"/></div>
<div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Scheduled</option><option>Completed</option><option>Cancelled</option></select></div></div>
<div class="mt-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control"></textarea></div>
<div class="mt-4"><button class="btn btn-primary">Save Appointment</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
