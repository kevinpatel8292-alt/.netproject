@model IEnumerable<Patient>
@{ ViewData["Title"] = "Patients"; }
<div class="d-flex justify-content-between align-items-center mb-3">
<h2>Patients</h2><a class="btn btn-primary" asp-action="Create">+ Add Patient</a>
</div>
<div class="table-responsive bg-white rounded-3 shadow-sm">
<table class="table table-hover mb-0">
<thead><tr><th>Name</th><th>Phone</th><th>Gender</th><th>Age</th><th>Address</th><th>Actions</th></tr></thead>
<tbody>
@foreach (var p in Model) {
<tr><td>@p.Name</td><td>@p.Phone</td><td>@p.Gender</td><td>@p.Age</td><td>@p.Address</td>
<td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.PatientId">Edit</a>
<a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@p.PatientId">Delete</a></td></tr>
}
</tbody></table></div>
