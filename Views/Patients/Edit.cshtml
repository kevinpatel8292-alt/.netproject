@model Patient
@{ ViewData["Title"] = "Edit Patient"; }
<h2>Edit Patient</h2>
<form asp-action="Edit" method="post" class="card p-4 shadow-sm border-0">
<input type="hidden" asp-for="PatientId"/>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
<div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control"/><span asp-validation-for="Phone" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Gender" class="form-label"></label><select asp-for="Gender" class="form-select"><option>Male</option><option>Female</option><option>Other</option></select></div>
<div class="col-md-4"><label asp-for="Age" class="form-label"></label><input asp-for="Age" type="number" class="form-control"/></div>
<div class="col-md-8"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control"/></div>
</div><div class="mt-4"><button class="btn btn-primary">Update</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
